# ==============================================================================
# FLUX — Environment Configuration Template
# Copy this file to .env before starting the application
# ==============================================================================

# Environment (development | production)
ENVIRONMENT=development
DEBUG=true

# Server Binding (Cloud hosts pass PORT dynamically)
HOST=0.0.0.0
PORT=8000

# Security (Set a strong 32+ character random secret in production)
SECRET_KEY=flux-super-secret-jwt-key-for-evaluation-change-in-prod-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Connection
# SQLite (Local zero-config default):
DATABASE_URL=sqlite+aiosqlite:///./flux_market.db
# PostgreSQL (Production cloud database):
# DATABASE_URL=postgresql+asyncpg://user:password@hostname:5432/flux_db

# CORS Allowed Origins (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,*

# Frontend API Base URL (Used by Vite build)
# Leave blank for local dev (uses Vite proxy) or monolith deployment
# Set to backend URL when frontend is hosted separately on Vercel/Netlify:
# VITE_API_URL=https://your-flux-api.onrender.com

# Market Freshness Thresholds (seconds)
FRESHNESS_LIVE_SEC=15
FRESHNESS_RECENT_SEC=300
FRESHNESS_STALE_SEC=900
